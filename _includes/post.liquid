				This website uses <a href="https://www.simpleanalytics.com/">Simple Analytics</a>. This means that we collect "anonymous usage data", including page views and browser versions.<br/>
				This website uses a self hosted version of Umami Analytics. This means that we collect "anonymous usage data", including page views and browser versions.<br/>
                <noscript><br/>Congratulations, this website does not need JavaScript! Turn on JavaScript to get a cool cursor effect!</noscript>

				<vb-badges>
					<a href="https://dashboard.simpleanalytics.com/?utm_source=blog.velocifyer.com&utm_content=badge&affiliate=dubev" referrerpolicy="origin" target="_blank"	>
						<img src="https://simpleanalyticsbadges.com/blog.velocifyer.com?mode=dark?counter=true" loading="lazy" referrerpolicy="no-referrer" crossorigin="anonymous"  role="img" alt="This Website uses Simple Analytics" type="image/svg+xml"/>
					</a>
					<a href="https://firefox.com">
						<img src="/Assets/Images/Badges/tested on Firefox.gif" loading="lazy" type="image/gif" alt="This website is tested on Firefox."/>
					</a>
					<a href="https://mastodon.social/@Velocifyer"><img src="/Assets/Images/Badges/Follow me on Mastadon.png" alt="Follow me on Mastadon" loading="lazy"/></a>
				</vb-badges>
            </small>
        </footer>
		<!-- cursorlag -->
        <link  href="/cursorlag/cursorlag.css" rel="stylesheet"/>
        <script>
			{% include "cursorlag/cursorlag.js" %}
		</script>
		<!-- Instant.page -->
		<script type="module">
			{% include "Assets/Scripts/Instant[.]page/5.2.0-instant.js" %}
		</script>
    </body>
</html>
