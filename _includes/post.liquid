---
width: 600px
uses-h3: false
has-date: false
---
<!doctype html>
<html lang="en-US">
    <head>
        <meta charset="utf-8"/>
		<title>{{title}} | Blog-ifyer</title>
		<meta name="color-scheme" content="dark"/>
        <meta
            name="description"
            content="{{description}} - Blog-ifyer"
        />
        <meta name="viewport" content="width=device-width"/>
		<style>
			{% include "Assets/Styles/hacks.css" %}
		</style>
        <style> /* Inline stylesheet */
			{%  include "Assets/Styles/josh-css-reset.css" %}
		</style>
		<style>
			{% include "Assets/Styles/style3.css" %}
		</style>
        <!-- TODO: Figure out how to only load the font face definitions on pages that use the fonts. -->
		<!-- TODO: Figure out how to inline these stylesheets -->
        <link href="/Assets/Fonts/Fira/Code/2025-8-13/fira-code.css" rel="stylesheet"/>
		<link rel="preload" href="/node_modules/@fontsource-variable/google-sans-flex/files/google-sans-flex-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
		<link rel="stylesheet" href="/node_modules/@fontsource-variable/google-sans-flex/wght.css"/>


		<style>
			{% include "node_modules/prismjs/themes/prism-okaidia.min.css" %}
		</style>
		<style>
			{% include "Assets/Styles/notes.css" %}
		</style>

		<!-- Feeds -->
		<link rel="alternate" type="application/atom+xml"  title="Blog-Ifyer Atom Feed" href="/Posts/feed.atom"      >
		<link rel="alternate" type="application/feed+json" title="Blog-Ifyer JSON Feed" href="/Posts/Feeds/feed.json">
		<link rel="alternate" type="application/rss+xml"   title="Blog-Ifyer RSS Feed" href="/Posts/Feeds/rss.xml"   >

		<!-- Better referer policy -->
		<meta name="referrer" content="unsafe-url">

        <meta name="author" content="𝕍𝕖𝕝𝕠𝕔𝕚𝕗𝕪𝕖𝕣"/>

        <link rel="me" href="https://mastodon.social/@Velocifyer"/>
        <meta name="fediverse:creator" content="@Velocifyer@mastodon.social"/>

		<meta name="generator" content="{{ eleventy.generator }}">
		<link rel="icon" href="/Assets/Images/spacetoad.jpg" type="image/jpeg"/>

		<!-- HTML5 shiv.
		 	Fixes old IE
		-->
		<!--[if lt IE 9]>
			<script src="bower_components/html5shiv/dist/html5shiv.js"></script>
		<![endif]-->
    </head>
    <body>
		<header>
			<a href="/" id="home-link">Blog-𝕚𝕗𝕪𝕖𝕣</a>
			<nav>
				<h2 class="visually-hidden" id="top-level-navigation-menu">Top level navigation menu</h2>
				<ul class="nav">
					<li class="nav-item"><a href="/" aria-current="page">Home</a></li>
					<li class="nav-item"><a href="/Blogroll.html">Blogroll</a></li>
				</ul>
			</nav>
		</header>
		<!--[if IE]>
  			<p>Please update your browser. We recommend Firefox 156 or something using webkit. Chromium is also ok.</p>
		<![endif]-->
        <main>
			<article>
				<aside class="toc">
					<nav class="toc toc_">
						{{content | toc}}
					</nav>
				</aside>
				<heading-anchors>
						<h1>{{ h1 | default: title }}</h1>
					{% if has-dates %}
						<vb-dates>
							{% for date in dates %} 	
								<time datetime="{{ date }}">{{ date }}</time>{% unless forloop.last %}, {% endunless %}
							{% endfor %}
						</vb-dates>
					{% endif %}
					{{content}}
				</heading-anchors>
			</article>
        </main>

		<!-- Heading Anchors -->
		<script type="module">
			{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}
		</script>
		<!-- Simple analytics -->
		<script data-collect-dnt="true" async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
		<noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif?collect-dnt=true" alt="" referrerpolicy="no-referrer-when-downgrade"/></noscript>
		<!-- Umami analytics -->
		<script defer src="https://umami.velocifyer.com/script.js" data-website-id="8b458155-4bff-4cad-9e6e-66a5d5bbb87b"></script>

        <footer>
            <small>
                <a href="/Posts/feed.atom" data-no-instant>Atom Feed</a> <a href="/Posts/Feeds/feed.json" data-no-instant>JSON feed</a> <a href="/Posts/Feeds/rss.xml" data-no-instant>RSS feed</a> <br/>
                <a href="/Blogroll.html">Blogroll </a><br/>
                To contact Velocifyer, email veolcifyer [at​] velocifyer[.]com, but fixing the type based on the domain (to stop bots).<br/>
                Velocifyer's OpenPGP Certificate is <a href="/pgp-certificate.asc">1BA0 FC4B 80E0 F21B 0269 8CEE 634E BF87 40C7 48BE</a>.<br/>
